              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <color column="[housing].[none:area:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[housing].[sum:value:qk]</rows>
        <cols>[housing].[none:year:ok]</cols>
      </table>
      <simple-id uuid="{E96EB4E5-97D5-489D-ABFA-C2BC513F4F4A}" />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="PEI Housing Pressure Monitor">
      <style />
      <size maxheight="850" maxwidth="1200" minheight="850" minwidth="1200" />
      <zones>
        <zone h="100000" w="100000" x="0" y="0" id="1" type-v2="layout-basic">
          <zone id="3" name="1 | PEI population change" x="1500" y="14000" w="47000" h="34000" />
          <zone id="4" name="2 | PEI completions (ends 2022)" x="50500" y="14000" w="47000" h="34000" />
          <zone id="5" name="3 | Average two-bedroom rent (CAD)" x="1500" y="50000" w="47000" h="34000" />
          <zone id="6" name="4 | Rental vacancy (%)" x="50500" y="50000" w="47000" h="34000" />
          <zone id="2" x="1500" y="500" w="97000" h="12000" type-v2="text">
            <formatted-text>
              <run fontname="Arial" fontsize="11">PEI HOUSING PRESSURE MONITOR
Province-wide population/completions context; separate urban rental survey areas.</run>
            </formatted-text>
            <zone-style />
          </zone>
          <zone id="9" x="1500" y="87500" w="97000" h="12000" type-v2="text">
            <formatted-text>
              <run fontname="Arial" fontsize="11">Completions end 2022. Rental observations through 2025. Missing values are not zero.
Rent/vacancy: privately initiated row/apartment structures of 3+ units. No rural estimate or causal housing deficit.
Source: Statistics Canada / CMHC. See methodology and source manifest in repository.</run>
            </formatted-text>
            <zone-style />
          </zone>
          <zone-style />
        </zone>
      </zones>
      <simple-id uuid="{88F7D278-9ABF-4D7F-A6B9-C1E232BF46A1}" />
    </dashboard>
  </dashboards>
  <windows>
    <window class="dashboard" name="PEI Housing Pressure Monitor" maximized="true">
      <viewpoints>
        <viewpoint name="1 | PEI population change">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="2 | PEI completions (ends 2022)">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="3 | Average two-bedroom rent (CAD)">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="4 | Rental vacancy (%)">
          <zoom type="entire-view" />
        </viewpoint>
      </viewpoints>
      <active id="-1" />
      <simple-id uuid="{A134F327-0A4D-479A-AA06-6BEE86A82B51}" />
    </window>
  </windows>
