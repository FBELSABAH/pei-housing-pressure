    <worksheet name="4 | Rental vacancy (%)">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="12" bold="true">4 | Rental vacancy (%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="PEI | Official housing indicators" name="housing" />
